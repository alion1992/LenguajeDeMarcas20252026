
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="facturas">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="codigo">
                    <xs:complexType>
                        <xs:simpleContent>
                            <xs:extension base="xs:string">
                                <xs:attribute name="tipo" type="xs:string" use="required"></xs:attribute>
                            </xs:extension>
                        </xs:simpleContent>

                    </xs:complexType>   

                </xs:element>
                <xs:element name="ano" type="xs:integer"/>
                <xs:element name="edad" type="edadTipo"/>
                
            </xs:sequence>
            
        </xs:complexType>
    </xs:element>
    <xs:simpleType name="edadTipo">
     <xs:restriction base="xs:int">
    <xs:minInclusive value="0"/>
    <xs:maxInclusive value="120"/>
  </xs:restriction>
</xs:simpleType>
</xs:schema>